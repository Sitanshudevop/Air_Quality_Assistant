{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "api/**/*.ts!",
    "scripts/**/*.mjs!"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "api/**/*.ts!",
    "server/**/*.ts!",
    "shared/**/*.ts!",
    "scripts/**/*.{mjs,ts}!"
  ],
  "ignoreDependencies": [
    "eslint-plugin-react-hooks",
    "eslint-plugin-react-refresh",
    "prettier",
    "vite"
  ],
  "ignoreBinaries": [
    "vite"
  ],
  "rules": {
    "types": "off"
  }
}
